          }
        }
      }
    },
    "Switch on the front camera for recording.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga a câmera frontal para gravar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la cámara frontal para grabar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la fotocamera frontale per registrare."
          }
        }
      }
    },
    "Take saved to Photos": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação salva em Fotos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma guardada en Fotos"
          }
        },
        "it": {
          "stringUnit": {
