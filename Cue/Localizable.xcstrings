    "A pre-roll before listening starts, so you can check your framing and settle before you speak. Tap anywhere to cancel the start if you're not ready.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma contagem antes de a escuta começar, para você conferir o enquadramento e se preparar antes de falar. Toque em qualquer lugar para cancelar o início se não estiver pronto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta atrás antes de empezar a escuchar, para que revises el encuadre y te prepares antes de hablar. Toca en cualquier parte para cancelar el inicio si no estás listo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto alla rovescia prima dell'ascolto, per controllare l'inquadratura e rilassarti prima di parlare. Tocca in un punto qualsiasi per annullare la partenza se non sei pronto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorlauf, bevor das Zuhören beginnt, damit du den Bildausschnitt prüfen und dich sammeln kannst. Tippe irgendwo, um den Start abzubrechen, wenn du noch nicht bereit bist."
          }
        }
      }
    },
