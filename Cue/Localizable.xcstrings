        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una ripresa dalla fotocamera. La registrazione viene salvata in Foto quando ti fermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt mit der Kamera auf. Die Aufnahme wird in Fotos gespeichert, sobald du stoppst."
          }
