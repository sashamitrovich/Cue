    "It uses your phone's speech model": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o modelo de fala do seu celular"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el modelo de voz de tu teléfono"
