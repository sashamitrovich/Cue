    "%@ didn't contain any readable text.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não continha texto legível."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no contenía texto legible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non conteneva testo leggibile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthielt keinen lesbaren Text."
          }
        }
      }
    },
    "%@ is on this device. From your next take, On Cue listens offline.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está neste dispositivo. A partir da próxima gravação, o On Cue escuta offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está en este dispositivo. Desde tu próxima toma, On Cue escucha sin conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è su questo dispositivo. Dalla prossima ripresa On Cue ascolta offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist jetzt auf diesem Gerät. Ab der nächsten Aufnahme hört On Cue offline zu."
          }
        }
      }
    },
    "%@ is still downloading, so this take uses Apple's server-based speech recognition, the same service iOS uses for Dictation. From your next take, On Cue listens on this device.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda está sendo baixado, então esta gravação usa o reconhecimento de fala em servidor da Apple, o mesmo serviço que o iOS usa para o Ditado. A partir da próxima gravação, o On Cue escuta neste dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ todavía se está descargando, así que esta toma usa el reconocimiento de voz en servidor de Apple, el mismo servicio que iOS usa para el dictado. Desde tu próxima toma, On Cue escucha en este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è ancora in download, quindi questa ripresa usa il riconoscimento vocale su server di Apple, lo stesso servizio che iOS usa per la dettatura. Dalla prossima ripresa On Cue ascolta su questo dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird noch geladen, deshalb nutzt diese Aufnahme die serverbasierte Spracherkennung von Apple – denselben Dienst, den iOS für die Diktierfunktion verwendet. Ab der nächsten Aufnahme hört On Cue auf diesem Gerät zu."
          }
        }
      }
    },
    "%@ isn't available as a local service on the device, and Apple's server-based speech recognition can't be reached. Check your internet connection, or pick another language.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está disponível como serviço local no dispositivo, e não foi possível acessar o reconhecimento de fala em servidor da Apple. Verifique sua conexão com a internet ou escolha outro idioma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está disponible como servicio local en el dispositivo y no se puede acceder al reconocimiento de voz en servidor de Apple. Revisa tu conexión a internet o elige otro idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è disponibile come servizio locale sul dispositivo e non è possibile raggiungere il riconoscimento vocale su server di Apple. Controlla la connessione a internet o scegli un’altra lingua."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht als lokaler Dienst auf dem Gerät verfügbar, und die serverbasierte Spracherkennung von Apple ist nicht erreichbar. Prüfe deine Internetverbindung oder wähle eine andere Sprache."
          }
        }
      }
    },
    "%@ isn't available as a local service on the device, so On Cue uses Apple's server-based speech recognition, the same service iOS uses for Dictation. It needs an internet connection.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está disponível como serviço local no dispositivo, então o On Cue usa o reconhecimento de fala em servidor da Apple, o mesmo serviço que o iOS usa para o Ditado. É preciso conexão com a internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está disponible como servicio local en el dispositivo, así que On Cue usa el reconocimiento de voz en servidor de Apple, el mismo servicio que iOS usa para el dictado. Necesita conexión a internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è disponibile come servizio locale sul dispositivo, quindi On Cue usa il riconoscimento vocale su server di Apple, lo stesso servizio che iOS usa per la dettatura. Serve una connessione a internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht als lokaler Dienst auf dem Gerät verfügbar, deshalb nutzt On Cue die serverbasierte Spracherkennung von Apple – denselben Dienst, den iOS für die Diktierfunktion verwendet. Dafür ist eine Internetverbindung nötig."
          }
        }
      }
    },
