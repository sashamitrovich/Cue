            "value": "Girare il telefono"
          }
        }
      }
    },
    "Turns the live camera view behind the script on or off.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga ou desliga a imagem ao vivo da câmera atrás do roteiro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la vista en vivo de la cámara detrás del guion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva l'immagine dal vivo della fotocamera dietro lo script."
          }
        }
      }
    },
    "Use It": {
