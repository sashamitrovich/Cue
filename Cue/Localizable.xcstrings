          }
        }
      }
    },
    "Take saved to Photos · %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação salva em Fotos · %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma guardada en Fotos · %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripresa salvata in Foto · %@"
          }
        }
      }
    },
    "Tap Listen and start speaking. On Cue matches what it hears against your script and scrolls to keep the line you're on at the reading line. Stop talking and it waits. Paraphrase, skip a word, or start a sentence again and it stays with you.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Ouvir e comece a falar. O On Cue compara o que ouve com o seu roteiro e rola o texto para manter a linha em que você está na linha de leitura. Parou de falar, ele espera. Parafraseie, pule uma palavra ou recomece uma frase, e ele continua com você."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Escuchar y empieza a hablar. On Cue compara lo que oye con tu guion y se desplaza para mantener la línea en la que vas en la línea de lectura. Si dejas de hablar, espera. Si parafraseas, omites una palabra o empiezas una frase otra vez, sigue contigo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Ascolta e inizia a parlare. On Cue confronta ciò che sente con il tuo script e scorre per tenere la riga in cui sei alla riga di lettura. Se smetti di parlare, aspetta. Se parafrasi, salti una parola o ricominci una frase, ti resta dietro."
          }
        }
      }
    },
    "Tap anywhere to cancel": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em qualquer lugar para cancelar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca en cualquier parte para cancelar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca in un punto qualsiasi per annullare"
          }
        }
      }
    },
    "Tap pause to stop listening": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em pausar para parar de ouvir"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca pausa para dejar de escuchar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca pausa per smettere di ascoltare"
          }
        }
      }
    },
    "Tap play to begin": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em play para começar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca reproducir para empezar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca play per iniziare"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto"
          }
        },
        "es": {
