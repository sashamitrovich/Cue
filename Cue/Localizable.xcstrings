    "\"%@\" was shared with On Cue. Using it replaces the script you have here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" foi compartilhado com o On Cue. Usá-lo substitui o roteiro que você tem aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se compartió con On Cue. Si lo usas, reemplaza el guion que tienes aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" è stato condiviso con On Cue. Se lo usi, sostituisce lo script che hai qui."
          }
        }
      }
    },
