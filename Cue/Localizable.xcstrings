            "state": "translated",
            "value": "Usa il modello vocale del tuo telefono"
          }
        }
      }
    },
    "Jumps back to the first word and starts the timing over.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta para a primeira palavra e zera a contagem de tempo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a la primera palabra y reinicia el cronómetro."
