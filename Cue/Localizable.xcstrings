            "state": "translated",
            "value": "Allineamento del testo"
          }
        }
      }
    },
    "Text and Dim": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto e Escurecer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto y Atenuar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo e Oscura"
          }
        }
      }
    },
    "Text fades the script so more of the camera shows through; Dim darkens the picture behind it. Between them you can keep the words legible over any background.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto esmaece o roteiro para mostrar mais da câmera; Escurecer escurece a imagem atrás dele. Com os dois, você mantém as palavras legíveis sobre qualquer fundo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto atenúa el guion para que se vea más de la cámara a través de él; Atenuar oscurece la imagen detrás. Entre los dos puedes mantener las palabras legibles sobre cualquier fondo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo rende lo script più trasparente, così si vede di più la fotocamera; Oscura scurisce l'immagine dietro di esso. Con i due puoi mantenere le parole leggibili su qualsiasi sfondo."
          }
        }
      }
    },
    "Text size": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho do texto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del texto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione del testo"
          }
        }
      }
    },
    "The marked line your eyes read from. Adjust it any time from the settings button, to keep it as near to the lens as possible.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha marcada de onde seus olhos leem. Ajuste-a quando quiser pelo botão de ajustes, para mantê-la o mais perto possível da lente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea marcada desde la que leen tus ojos. Ajústala cuando quieras desde el botón de ajustes, para tenerla lo más cerca posible del objetivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga evidenziata da cui leggono i tuoi occhi. Regolala quando vuoi dal pulsante delle impostazioni, per tenerla il più vicino possibile all'obiettivo."
          }
        }
      }
    },
    "The screen stays awake for as long as the prompter is open.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela fica ligada enquanto o prompter estiver aberto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla permanece encendida mientras el prompter esté abierto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo resta acceso finché il teleprompter è aperto."
          }
        }
      }
    },
    "The script follows your voice": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O roteiro acompanha a sua voz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guion sigue tu voz"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo script segue la tua voce"
          }
        }
      }
    },
    "Timing": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo"
          }
        }
      }
    },
    "Tip: say scroll up to go back a line": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: diga scroll up para voltar uma linha"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: di scroll up para retroceder una línea"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: di' scroll up per tornare indietro di una riga"
          }
        }
      }
    },
    "Turn camera off": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligar a câmera"
          }
