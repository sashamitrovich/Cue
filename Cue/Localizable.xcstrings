    "Text alignment": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhamento do texto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alineación del texto"
          }
        },
        "it": {
