        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una toma con la cámara. La grabación se guarda en Fotos cuando la detienes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una ripresa dalla fotocamera. La registrazione viene salvata in Foto quando ti fermi."
          }
        }
      }
    },
