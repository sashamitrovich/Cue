            "value": "Zieh das Skript mit dem Finger"
          }
        }
      }
    },
    "Editing %@ — changes save automatically": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Editando %@ — as alterações são salvas automaticamente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editando %@: los cambios se guardan automáticamente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica di %@ — le modifiche si salvano automaticamente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird bearbeitet – Änderungen werden automatisch gespeichert"
          }
        }
      }
    },
    "Elapsed %@, about %@ remaining": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Elapsed %1$@, about %2$@ remaining"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Decorrido: %@, restam cerca de %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcurrido %@, quedan unos %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascorso %@, circa %@ rimanenti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vergangen, noch etwa %@"
          }
        }
      }
    },
    "Elapsed speaking time, an estimate of what's left, and your pace. The estimate is marked with a ~ until On Cue has heard enough of the take to measure how fast you actually talk.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo de fala decorrido, uma estimativa do que falta e o seu ritmo. A estimativa fica marcada com ~ até o On Cue ouvir o suficiente da gravação para medir a velocidade com que você realmente fala."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de habla transcurrido, una estimación de lo que falta y tu ritmo. La estimación lleva una ~ hasta que On Cue ha oído suficiente de la toma para medir a qué velocidad hablas en realidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo di parlato trascorso, una stima di quello che resta e il tuo ritmo. La stima è contrassegnata da ~ finché On Cue non ha ascoltato abbastanza della ripresa da misurare quanto velocemente parli davvero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergangene Sprechzeit, eine Schätzung der Restzeit und dein Tempo. Die Schätzung ist mit ~ markiert, bis On Cue genug von der Aufnahme gehört hat, um zu messen, wie schnell du tatsächlich sprichst."
          }
        }
      }
    },
    "Enable Photos access to save your take (it's still on disk as %@).": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso a Fotos para salvar sua gravação (ela continua no dispositivo como %@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el acceso a Fotos para guardar tu toma (sigue en el dispositivo como %@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l'accesso a Foto per salvare la ripresa (è ancora sul dispositivo come %@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Fotos, um deine Aufnahme zu sichern (sie liegt noch als %@ auf dem Gerät)."
          }
        }
      }
    },
    "Estimated reading pace: %lld words per minute": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo de leitura estimado: %lld palavras por minuto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo de lectura estimado: %lld palabras por minuto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo di lettura stimato: %lld parole al minuto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätztes Lesetempo: %lld Wörter pro Minute"
          }
        }
      }
    },
    "Exit": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        }
      }
    },
    "Find the lens": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre a lente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra el objetivo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova l'obiettivo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blick zur Linse"
          }
        }
      }
    },
    "Flips the script top-to-bottom for teleprompter rigs that bounce the screen off a sheet of glass in front of the lens; the reflection turns it back the right way round. The controls stay exactly where they are and read normally, since you look at them directly rather than through the glass. Reading straight from the phone? Leave it off.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverte o roteiro de cima para baixo para teleprompters que refletem a tela em uma lâmina de vidro na frente da lente; o reflexo o devolve ao sentido certo. Os controles ficam exatamente onde estão e continuam normais, já que você olha para eles diretamente, não pelo vidro. Lendo direto do celular? Deixe desativado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltea el guion de arriba abajo para los teleprompters que reflejan la pantalla en un cristal colocado frente al objetivo; el reflejo lo devuelve a su orientación correcta. Los controles se quedan donde están y se leen con normalidad, porque los miras directamente y no a través del cristal. ¿Lees directamente del teléfono? Déjalo desactivado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capovolge lo script dall'alto in basso per i teleprompter che riflettono lo schermo su un vetro davanti all'obiettivo; il riflesso lo rimette per il verso giusto. I controlli restano esattamente dove sono e si leggono normalmente, perché li guardi direttamente e non attraverso il vetro. Leggi direttamente dal telefono? Lascialo disattivato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Skript auf den Kopf – für Teleprompter-Aufbauten, die den Bildschirm über eine Glasscheibe vor der Linse spiegeln; die Spiegelung dreht es wieder richtig herum. Die Bedienelemente bleiben genau, wo sie sind, und lesen sich normal, weil du sie direkt ansiehst und nicht durch das Glas. Liest du direkt vom Telefon? Dann lass es aus."
          }
        }
      }
    },
    "Frame rate": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxa de quadros"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogramas por segundo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenza fotogrammi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildrate"
          }
        }
      }
    },
    "From another app — Notes, Mail, Files, Drive — tap Share and choose On Cue. It waits for you here and asks before replacing the script you already have. A Google Doc shares as a link rather than text, so use \"Send a copy\" and pick plain text or rich text.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em outro app — Notas, Mail, Arquivos, Drive — toque em Compartilhar e escolha On Cue. Ele espera por você aqui e pergunta antes de substituir o roteiro que você já tem. Um Google Doc é compartilhado como link, e não como texto; por isso use \"Enviar uma cópia\" e escolha texto simples ou texto formatado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde otra app (Notas, Mail, Archivos, Drive), toca Compartir y elige On Cue. El guion te espera aquí y te pregunta antes de reemplazar el que ya tienes. Un documento de Google se comparte como enlace y no como texto, así que usa \"Enviar una copia\" y elige texto sin formato o texto enriquecido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un'altra app — Note, Mail, File, Drive — tocca Condividi e scegli On Cue. Lo script aspetta qui e ti chiede conferma prima di sostituire quello che hai già. Un Documento Google si condivide come link e non come testo, quindi usa \"Invia una copia\" e scegli testo semplice o testo formattato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in einer anderen App – Notizen, Mail, Dateien, Drive – auf Teilen und wähle On Cue. Das Skript wartet hier auf dich, und On Cue fragt, bevor es dein vorhandenes Skript ersetzt. Ein Google-Dokument wird als Link statt als Text geteilt; nutze daher „Kopie senden“ und wähle Nur-Text oder Rich Text."
          }
        }
      }
    },
    "Get ready…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare-se…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepárate…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparati…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleich geht’s los …"
          }
        }
      }
    },
    "HD / 4K": {
      "shouldTranslate": false
    },
    "HDR video": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeo HDR"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Video HDR"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Video HDR"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR-Video"
          }
        }
      }
    },
    "How On Cue works": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o On Cue funciona"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funciona On Cue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come funziona On Cue"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert On Cue"
          }
        }
      }
    },
    "Import": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren"
          }
        }
      }
    },
    "In landscape the controls move to a rail on the edge they were already on, so they stay under the same thumb and stop eating the height you need for the script.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na horizontal, os controles passam para uma barra lateral, no mesmo lado em que já estavam, e continuam sob o mesmo polegar sem ocupar a altura de que você precisa para o roteiro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En horizontal, los controles pasan a una barra en el borde en el que ya estaban, así siguen bajo el mismo pulgar y no te quitan la altura que necesitas para el guion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In orizzontale i controlli si spostano in una barra sul lato in cui si trovavano, così restano sotto lo stesso pollice e non occupano più l'altezza che serve allo script."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Querformat wandern die Bedienelemente in eine Leiste an der Seite, auf der sie schon waren – so bleiben sie unter demselben Daumen und nehmen dem Skript keine Höhe weg."
          }
        }
      }
    },
    "In the listening mode, it steps the script back one line on screen and moves the cursor with it, so that line reads as unread again. Say it again to go back further.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo de escuta, volta o roteiro uma linha na tela e leva o cursor junto, de modo que essa linha volta a contar como não lida. Diga de novo para voltar mais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo de escucha, retrocede el guion una línea en pantalla y mueve el cursor con él, de modo que esa línea vuelve a quedar sin leer. Dilo de nuevo para retroceder más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità ascolto, riporta lo script indietro di una riga sullo schermo e sposta il cursore con esso, così quella riga risulta di nuovo da leggere. Ripetilo per tornare ancora indietro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zuhören springt das Skript eine Bildschirmzeile zurück, und die Markierung wandert mit, sodass diese Zeile wieder als ungelesen gilt. Sag es noch einmal, um weiter zurückzugehen."
          }
        }
      }
    },
    "In the prompter": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
