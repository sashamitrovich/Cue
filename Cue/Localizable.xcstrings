    "Microphone access was denied. Enable it in Settings → Privacy & Security → Microphone → On Cue.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone foi negado. Ative em Ajustes → Privacidade e Segurança → Microfone → On Cue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el acceso al micrófono. Actívalo en Ajustes → Privacidad y seguridad → Micrófono → On Cue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono è stato negato. Attivalo in Impostazioni → Privacy e sicurezza → Microfono → On Cue."
          }
        }
      }
