            "value": "Es nutzt das Sprachmodell deines Telefons"
          }
        }
      }
    },
    "Jumps back to the first word and starts the timing over.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta para a primeira palavra e zera a contagem de tempo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a la primera palabra y reinicia el cronómetro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna alla prima parola e riavvia il conteggio del tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springt zum ersten Wort zurück und startet die Zeitmessung neu."
          }
        }
      }
    },
